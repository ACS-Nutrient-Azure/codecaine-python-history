# History Service 환경변수 예시
# cp .env.example .env 후 실제 값으로 채울 것

APP_NAME=History Service
APP_ENV=development
APP_PORT=8004

# ── Database (필수) ───────────────────────────────────────────────────────────
# asyncpg 드라이버 사용
# intake_supplements 테이블은 AWS DMS로 mypage current_supplements에서 CDC 동기화됨
DATABASE_URL=postgresql+asyncpg://vitamin_history:<password>@<host>:5432/vitamin_history

# ── AWS Cognito — JWT 인증 (선택) ────────────────────────────────────────────
# 설정 시 RS256 JWKS 검증. 미설정 시 JWT_SECRET_KEY로 HS256 fallback (개발 전용)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=ap-northeast-2

# ── JWT fallback — Cognito 미설정 시 개발 전용 ────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
